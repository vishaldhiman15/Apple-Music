MONGODB_URI=mongodb://127.0.0.1:27017/music-max
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=5001
HOST=127.0.0.1
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Use true when served over HTTPS.
COOKIE_SECURE=false
# Optional, only required for signed cloud audio uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternative to the three Cloudinary values above:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
